# PostgreSQL Database
POSTGRES_USER='openmart'
POSTGRES_PASSWORD='pgmart'
POSTGRES_DB='open-mart'
POSTGRES_PORT='6432'
POSTGRES_DB_URL='postgresql://openmart:pgmart@localhost:6432/open-mart'

# Database Connection Pool Configuration
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30
DB_POOL_CONNECT_TIMEOUT=10

# Redis In-Memory Cache & Distributed Throttler
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD="redismart"
REDIS_KEY_PREFIX="om:"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Cloudflare R2 Storage
R2_ACCOUNT_ID="your_account_id"
R2_ACCESS_KEY_ID="your_access_key_id"
R2_SECRET_ACCESS_KEY="your_secret_access_key"
R2_BUCKET_NAME="open-mart"
R2_PUBLIC_URL="https://pub-your_bucket_id.r2.dev"

# Mail / SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="OPEN-MART <your-email@gmail.com>"

# JWT Configuration
JWT_ACCESS_TOKEN_SECRET="access_secret_min_32_characters"
JWT_REFRESH_TOKEN_SECRET="refresh_secret_min_32_characters"
JWT_ACCESS_EXPIRES="1d"
JWT_REFRESH_EXPIRES="27d"

# Password Hashing
BCRYPT_SALT_ROUND=10

# Google OAuth
GOOGLE_AUTH_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_AUTH_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/google/callback"
GOOGLE_ADMIN_CALLBACK_URL="http://localhost:3001/api/admin/auth/google/callback"
FRONTEND_URL="http://localhost:5173"
ADMIN_WEB_URL="http://localhost:5173"

# Admin Initial Setup & Registration Secret
INITIAL_ADMIN_EMAIL="admin@openmart.com"
INITIAL_ADMIN_PASSWORD="Admin123!@#"
ADMIN_REGISTRATION_SECRET="openmart-admin-secret-2026"

# SSLCommerz Payment Gateway
SSL_STORE_ID="your_store_id"
SSL_STORE_PASS="your_store_pass"
SSL_PAYMENT_API="https://sandbox.sslcommerz.com/gwprocess/v4/api.php"
SSL_VALIDATION_API="https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php"
SSL_IPN_URL="http://localhost:3001/api/payments/webhook/sslcommerz"
SSL_SUCCESS_BACKEND_URL="http://localhost:3001/api/payments/redirect/sslcommerz/callback"
SSL_FAIL_BACKEND_URL="http://localhost:3001/api/payments/redirect/sslcommerz/callback"
SSL_CANCEL_BACKEND_URL="http://localhost:3001/api/payments/redirect/sslcommerz/callback"
SSL_SUCCESS_FRONTEND_URL="http://localhost:5173/payment/success"
SSL_FAIL_FRONTEND_URL="http://localhost:5173/payment/fail"
SSL_CANCEL_FRONTEND_URL="http://localhost:5173/payment/cancel"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
API_BASE_URL="http://localhost:3001"
STRIPE_SUCCESS_URL="http://localhost:3001/api/payments/stripe/verify-session"
STRIPE_CANCEL_URL="http://localhost:5173/payment/cancel"
